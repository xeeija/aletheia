{
  "name": "aletheia-server",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --delay 2 dist/index.js",
    "start": "node dist/index.js",
    "build": "tsc --build && tsc-alias",
    "watch": "concurrently --kill-others -c auto -n tsc,alias 'tsc -w --preserveWatchOutput' 'tsc-alias -w -v'",
    "watch-tsc": "tsc --watch --preserveWatchOutput",
    "watch-alias": "tsc-alias --watch --verbose",
    "eventsub": "node dist/twitch/eventsub.js",
    "eventsub-watch": "nodemon --delay 2 dist/twitch/eventsub.js",
    "mock-api": "twitch mock-api start",
    "mock-auth": "node dist/twitch/mock/authorize.js",
    "ngrok": "ngrok start dev3000",
    "migrate": "prisma migrate dev --create-only --name",
    "migrate:deploy:prod": "dotenv -e .env.production -- prisma migrate deploy",
    "generate": "prisma generate && pnpm run generate:fix",
    "generate:fix": "sed -i -E 's/ (\\w+Null) / \\1: \\1 /g' src/generated/prisma/internal/prismaNamespace*.ts",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "keywords": [],
  "author": "xeeija",
  "license": "ISC",
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "engines": {
    "node": "^24.22.1 || ^26.12.1"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express4": "^1.1.2",
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "@twurple/api": "^7.1.0",
    "@twurple/auth": "^7.1.0",
    "@twurple/eventsub-base": "^7.1.0",
    "@twurple/eventsub-http": "^7.1.0",
    "argon2": "^0.41.1",
    "bufferutil": "^4.0.9",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-session": "^1.18.0",
    "graphql": "^16.9.0",
    "graphql-parse-resolve-info": "^4.13.0",
    "graphql-scalars": "^1.23.0",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.0",
    "tslib": "^2.7.0",
    "type-graphql": "^2.0.0-rc.2",
    "utf-8-validate": "^6.0.5"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.19",
    "@types/express": "4.17.14",
    "@types/express-session": "^1.18.0",
    "@types/node": "^24.19.2",
    "concurrently": "^9.0.1",
    "dotenv-cli": "^7.4.2",
    "nodemon": "^3.1.7",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prisma": "6.19.3",
    "tsc-alias": "^1.8.10",
    "typescript": "^7.0.2"
  }
}
