{
  "compilerOptions": {
    "target": "es2025",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "pretty": true,
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/style/*": ["./style/*"],
      "@/style": ["./style/index"],
    },
    // explicitly list the needed @types packages in TS 7, just "node" should be enough
    "types": ["node"],
    "plugins": [
      { "name": "next" },
    ],
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ],
}
