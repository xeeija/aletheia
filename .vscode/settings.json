{
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit",
    "source.removeUnusedImports": "explicit",
  },
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[html]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  // "[jsonc]": {
  //   "editor.defaultFormatter": "oxc.oxc-vscode"
  // },
  "[yaml]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "oxc.configPath": "server/.oxlintrc.json",
  "oxc.fmt.configPath": "server/.oxfmtrc.json",
  "oxc.path.oxfmt": "server/node_modules/.bin/oxfmt",
  "oxc.path.oxlint": "server/node_modules/.bin/oxlint",
  "oxc.path.tsgolint": "server/node_modules/.bin/tsgolint.cmd",
}
